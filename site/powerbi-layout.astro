    out.push(T(g.gx, fy, fit(S.footer, 10 * s, g.gw * 0.7), { size: 10 * s, fill: p.faint, ff: p.fbs }));
    out.push(T(g.gx + g.gw, fy, `${S.company ? S.company + "  ·  " : ""}${pi + 1 + (S.menu ? 1 : 0)} / ${pageCount()}`, { size: 10 * s, fill: p.faint, anchor: "end", ff: p.fbs }));
  }
  if (mode === "edit") {
    const over = overlaps(pg.cards);
    for (const c of pg.cards) if (over.has(c.id)) { const r = rectOf(c, g); out.push(`<rect x="${r1(r.x)}" y="${r1(r.y)}" width="${r1(r.w)}" height="${r1(r.h)}" rx="${r1(S.radius * s)}" fill="#C0402E" fill-opacity="0.08" stroke="#C0402E" stroke-width="${r1(2 * s)}" stroke-dasharray="${r1(6 * s)} ${r1(4 * s)}" pointer-events="none"/>`); }
    const sc = pg.cards.find((c) => c.id === sel) || (drag && drag.temp);
