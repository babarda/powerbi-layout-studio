const colRef = () => ({ field: { Column: { Expression: { SourceRef: { Entity: "Placeholder" } }, Property: "Item" } }, queryRef: "Placeholder.Item", nativeQueryRef: "Item" });
const meaRef = () => ({ field: { Measure: { Expression: { SourceRef: { Entity: "Placeholder" } }, Property: "Value" } }, queryRef: "Placeholder.Value", nativeQueryRef: "Value" });
const QUERY = {
  kpi: () => ({ Values: { projections: [meaRef()] } }),
  bar: () => ({ Category: { projections: [colRef()] }, Y: { projections: [meaRef()] } }),
  line: () => ({ Category: { projections: [colRef()] }, Y: { projections: [meaRef()] } }),
  donut: () => ({ Category: { projections: [colRef()] }, Y: { projections: [meaRef()] } }),
  table: () => ({ Values: { projections: [colRef(), meaRef()] } }),
  slicer: () => ({ Values: { projections: [colRef()] } }),
  map: () => ({ Category: { projections: [colRef()] } }),
};

async function buildPbip() {
  const name = (plainTitle() || "Report").replace(/[\\/:*?"<>|]/g, "").trim().slice(0, 40) || "Report";
  const RP = name + ".Report", SM = name + ".SemanticModel", { w: W, h: H } = sizeOf();
  const files = [], themeName = tk.slug(plainTitle()) + "-layout.json";
  const base = await (await fetch("/tools/pbi-layout/CY26SU02.json")).text();
  const pis = allPis(), images = [];
  for (let i = 0; i < pis.length; i++) {
    const pi = pis[i], img = `bg_${pid(pi)}_${Date.now().toString(36)}.png`;
    images.push(img);
    files.push({ name: `${RP}/StaticResources/RegisteredResources/${img}`, data: await pngBytes(pi) });
    const p = palette();
    files.push({ name: `${RP}/definition/pages/${pid(pi)}/page.json`, data: J({
      $schema: SCH + "item/report/definition/page/2.1.0/schema.json", name: pid(pi), displayName: pi === -1 ? "Home" : S.pages[pi].name, displayOption: "FitToPage", height: H, width: W,
      objects: {
        background: [{ properties: { image: { image: { name: lit(q(img)), url: { expr: { ResourcePackageItem: { PackageName: "RegisteredResources", PackageType: 1, ItemName: img } } }, scaling: lit("'Fit'") } }, transparency: lit("0D") } }],
        outspace: [{ properties: { color: solid(p.bg), transparency: lit("0D") } }],
      },
    }) });
    let zi = 1000;
    for (const z of zones(pi)) {
      const vdir = `${RP}/definition/pages/${pid(pi)}/visuals`;
      if (z.kind === "button") { const vn = `nav_${pid(pi)}_${pid(z.to)}`; files.push({ name: `${vdir}/${vn}/visual.json`, data: visualJson(vn, z, zi, buttonVisual(z.to, z.to === -1 ? "Home" : S.pages[z.to].name)) }); zi += 100; }
      else if (z.kind === "visual") { const vn = `v_${pid(pi)}_${z.id}`; files.push({ name: `${vdir}/${vn}/visual.json`, data: visualJson(vn, z, zi, placeholderVisual(z)) }); zi += 100; }
      else if (z.kind === "filter") { const vn = `f_${pid(pi)}_${tk.slug(z.name).replace(/-/g, "_")}`; files.push({ name: `${vdir}/${vn}/visual.json`, data: visualJson(vn, z, zi, { visualType: "slicer", query: { queryState: QUERY.slicer() }, objects: { data: [{ properties: { mode: lit("'Dropdown'") } }], header: [{ properties: { show: lit("false") } }] }, visualContainerObjects: { ...off("background"), ...off("border"), ...off("dropShadow"), ...off("title") }, drillFilterOtherVisuals: true }) }); zi += 100; }
    }
  }
  const ver = { visual: "2.6.0", report: "3.1.0", page: "2.3.0" };
  files.push({ name: `${name}.pbip`, data: J({ $schema: SCH + "pbip/pbipProperties/1.0.0/schema.json", version: "1.0", artifacts: [{ report: { path: RP } }], settings: { enableAutoRecovery: true } }) });
  files.push({ name: `${RP}/.platform`, data: J({ $schema: SCH + "gitIntegration/platformProperties/2.0.0/schema.json", metadata: { type: "Report", displayName: name }, config: { version: "2.0", logicalId: uuid() } }) });
  files.push({ name: `${RP}/definition.pbir`, data: J({ $schema: SCH + "item/report/definitionProperties/2.0.0/schema.json", version: "4.0", datasetReference: { byPath: { path: `../${SM}` } } }) });
  files.push({ name: `${RP}/definition/version.json`, data: J({ $schema: SCH + "item/report/definition/versionMetadata/1.0.0/schema.json", version: "2.0.0" }) });
  files.push({ name: `${RP}/definition/pages/pages.json`, data: J({ $schema: SCH + "item/report/definition/pagesMetadata/1.1.0/schema.json", pageOrder: pis.map(pid), activePageName: pid(pis[0]) }) });
  files.push({ name: `${RP}/definition/report.json`, data: J({
    $schema: SCH + "item/report/definition/report/3.3.0/schema.json",
    themeCollection: { baseTheme: { name: "CY26SU02", reportVersionAtImport: ver, type: "SharedResources" }, customTheme: { name: themeName, reportVersionAtImport: ver, type: "RegisteredResources" } },
    objects: { outspacePane: [{ properties: { expanded: lit("false") } }] },
    resourcePackages: [
      { name: "SharedResources", type: "SharedResources", items: [{ name: "CY26SU02", path: "BaseThemes/CY26SU02.json", type: "BaseTheme" }] },
      { name: "RegisteredResources", type: "RegisteredResources", items: [{ name: themeName, path: themeName, type: "CustomTheme" }, ...images.map((im) => ({ name: im, path: im, type: "Image" }))] },
    ],
    settings: { useStylableVisualContainerHeader: true, defaultDrillFilterOtherVisuals: true, allowChangeFilterTypes: true, useEnhancedTooltips: true, useDefaultAggregateDisplayName: true },
  }) });
  files.push({ name: `${RP}/StaticResources/SharedResources/BaseThemes/CY26SU02.json`, data: base });
  files.push({ name: `${RP}/StaticResources/RegisteredResources/${themeName}`, data: J(themeObj()) });
  files.push({ name: `${SM}/.platform`, data: J({ $schema: SCH + "gitIntegration/platformProperties/2.0.0/schema.json", metadata: { type: "SemanticModel", displayName: name }, config: { version: "2.0", logicalId: uuid() } }) });
  files.push({ name: `${SM}/definition.pbism`, data: J({ $schema: SCH + "item/semanticModel/definitionProperties/1.0.0/schema.json", version: "4.2", settings: {} }) });
  files.push({ name: `${SM}/definition/database.tmdl`, data: "database\n\tcompatibilityLevel: 1606\n\n" });
  files.push({ name: `${SM}/definition/model.tmdl`, data: "model Model\n\tculture: en-US\n\tdefaultPowerBIDataSourceVersion: powerBI_V3\n\tsourceQueryCulture: en-US\n\tdataAccessOptions\n\t\tlegacyRedirects\n\t\treturnErrorValuesAsNull\n\nannotation __PBI_TimeIntelligenceEnabled = 0\n\nannotation PBI_QueryOrder = [\"Placeholder\"]\n\nannotation PBI_ProTooling = [\"DevMode\"]\n\nref table Placeholder\n\n" });
  files.push({ name: `${SM}/definition/tables/Placeholder.tmdl`, data: `/// One-row table so the project opens. Replace it with your own data (Home, Get data).\ntable Placeholder\n\tlineageTag: ${uuid()}\n\n\tcolumn Item\n\t\tdataType: string\n\t\tlineageTag: ${uuid()}\n\t\tsummarizeBy: none\n\t\tsourceColumn: Item\n\n\t/// Stand-in value for the placeholder visuals.\n\tmeasure Value = 1\n\t\tformatString: 0\n\t\tlineageTag: ${uuid()}\n\n\tpartition Placeholder = m\n\t\tmode: import\n\t\tsource =\n\t\t\t\tlet\n\t\t\t\t    Source = #table(type table [Item = text], {{"Replace me with your data"}})\n\t\t\t\tin\n\t\t\t\t    Source\n\n\tannotation PBI_Id = Placeholder\n\n` });
  files.push({ name: "README.txt", data: readme().replace(/^1\./m, `Open ${name}.pbip in Power BI Desktop (unzip to a short path such as C:\\PBI\\ first). Pages, backgrounds, theme, page buttons and placeholder visuals are already in place.\r\n\r\nTo rebuild by hand:\r\n1.`) });
  return { name, data: tk.zip(files) };
}
$("#lg-pbip").addEventListener("click", async (e) => {
  const btn = e.currentTarget; btn.disabled = true; status("Building the Power BI project...");
  try { const { data } = await buildPbip(); tk.download(fileBase() + ".zip", data, "application/zip"); status(`Project saved (${Math.round(data.length / 1024)} KB). Unzip to a short path such as C:\\PBI\\ and open the .pbip.`); }
  catch (err) { status("The project could not be built: " + err.message, true); }
  btn.disabled = false;
});

/* ---------------------------------------------------------------- start */

load();
if (S.cur >= S.pages.length || (S.cur === -1 && !S.menu)) S.cur = 0;
window.__lg = { get S() { return S; }, buildPbip, pngBytes, themeObj, zones };
renderAll();
</script>
