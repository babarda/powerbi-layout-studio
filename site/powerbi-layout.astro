$("#lg-canvas").addEventListener("pointerdown", (e) => {
  if (S.cur === -1 || e.button !== 0) return;
  const g = geom(S.cur), pt = toPt(e), cell = cellAt(pt, g), pg = S.pages[S.cur];
  const hd = e.target.closest("[data-handle]"), cg = e.target.closest("[data-card]");
  if (hd) { const c = pg.cards.find((x) => x.id === hd.dataset.handle); drag = { kind: "size", c, start: JSON.stringify(S), moved: false }; }
  else if (cg) { const c = pg.cards.find((x) => x.id === cg.dataset.card); sel = c.id; drag = { kind: "move", c, dc: cell.c - c.c, dr: cell.r - c.r, start: JSON.stringify(S), moved: false }; renderBelow(); renderPositions(); }
  else if (pt.x >= g.gx && pt.x <= g.gx + g.gw && pt.y >= g.gy && pt.y <= g.gy + g.gh) { sel = null; drag = { kind: "draw", a: cell, temp: { id: "tmp", type: tool, title: TYPES[tool].label, c: cell.c, r: cell.r, w: 1, h: 1 } }; $("#lg-canvas").classList.add("drawing"); }
