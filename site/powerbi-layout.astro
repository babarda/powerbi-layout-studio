/* o: {mode: "edit" | "export" | "thumb", frame, cards} */
function svgPage(pi, o = {}) {
  const mode = o.mode || "export", g = geom(pi, o.frame), p = palette(), s = g.s, out = [];
  out.push(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${g.W} ${g.H}" width="${g.W}" height="${g.H}">`);
  out.push(`<defs><filter id="sh" x="-8%" y="-8%" width="116%" height="124%"><feDropShadow dx="0" dy="${r1(2 * s)}" stdDeviation="${r1(5 * s)}" flood-color="#0B1F1A" flood-opacity="${p.shadow}"/></filter></defs>`);
  out.push(R(0, 0, g.W, g.H, 0, p.bg));
  if (pi === -1) { out.push(menuSvg(g, p)); out.push("</svg>"); return out.join(""); }
  out.push(navSvg(pi, g, p));
  const pg = o.cards ? { name: "Overview", cards: o.cards } : S.pages[pi];
  if (g.head) {
    out.push(T(g.gx, g.ct.y + 20 * s + 26 * s, pg.name, { size: 24 * s, weight: 700, fill: p.ink, ff: p.fhs, ls: -0.3 * s }));
    const sub = g.f === "header" ? "" : (g.f === "tabs" ? S.subtitle : [S.subtitle].filter(Boolean).join(""));
    if (sub) out.push(T(g.gx, g.ct.y + 20 * s + 46 * s, fit(sub, 12 * s, g.gw * 0.6), { size: 12 * s, fill: p.faint, ff: p.fbs }));
    const chip = "Data as of 01 Oct 2026", cw = tw(chip, 11 * s) + 24 * s;
    out.push(`<rect x="${r1(g.gx + g.gw - cw)}" y="${r1(g.ct.y + 24 * s)}" width="${r1(cw)}" height="${r1(26 * s)}" rx="${r1(13 * s)}" fill="${p.cardFill}" stroke="${p.hair}" stroke-width="${r1(s)}"/>`);
    out.push(T(g.gx + g.gw - cw / 2, g.ct.y + 41 * s, chip, { size: 11 * s, fill: p.body, anchor: "middle", ff: p.fbs }));
  }
  if (mode === "edit" && showGrid) {
    for (let i = 0; i < COLS; i++) out.push(R(g.gx + i * (g.colW + g.gap), g.gy, g.colW, g.gh, 0, p.acc, ` fill-opacity="${S.mode === "dark" ? 0.07 : 0.05}" pointer-events="none"`));
    for (let j = 1; j < ROWS; j++) out.push(R(g.gx, g.gy + j * (g.rowH + g.gap) - g.gap / 2, g.gw, Math.max(0.6, 0.6 * s), 0, p.acc, ` fill-opacity="0.12" pointer-events="none"`));
