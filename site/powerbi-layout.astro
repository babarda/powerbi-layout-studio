      const lab = `${TYPES[sc.type].label} · ${sc.w} × ${sc.h} cells`, lw = tw(lab, 10.5 * s) + 16 * s;
      out.push(R(r.x - 3 * s, r.y - 26 * s, lw, 20 * s, 4 * s, "#0B7A6C", ` pointer-events="none"`) + T(r.x + 5 * s, r.y - 12 * s, lab, { size: 10.5 * s, weight: 600, fill: "#FFFFFF" }));
