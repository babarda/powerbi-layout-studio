function status(msg, err) { const s = $("#lg-status"); s.textContent = msg || ""; s.classList.toggle("err", !!err); }
const fileBase = () => tk.slug(plainTitle() || "report") + "-layout";
const pageFile = (pi, i) => `${String(i + 1).padStart(2, "0")}-${tk.slug(pi === -1 ? "home" : S.pages[pi].name)}`;
const allPis = () => [...(S.menu ? [-1] : []), ...S.pages.map((_, i) => i)];

async function pngBytes(pi, scale = 2) {
  const svg = svgPage(pi, { mode: "export" }), { w, h } = sizeOf();
  const img = new Image(); img.src = "data:image/svg+xml;charset=utf-8," + encodeURIComponent(svg);
  await img.decode();
  const cv = document.createElement("canvas"); cv.width = w * scale; cv.height = h * scale;
  const cx = cv.getContext("2d"); cx.drawImage(img, 0, 0, cv.width, cv.height);
  const blob = await new Promise((res) => cv.toBlob(res, "image/png"));
  return new Uint8Array(await blob.arrayBuffer());
}

function themeObj() {
  const p = palette(), b = p.brand;
  const t = tk.powerbiTheme({ ...b, name: tk.slug(plainTitle()) + "-layout.json", colors: p.series, background: p.cardFill, panel: p.bg, ink: p.ink, body: p.body, hairline: p.hair, gridline: p.grid, fontHeading: p.fh === "Segoe UI" ? "Segoe UI Semibold" : p.fh, fontBody: p.fb });
  const vs = t.visualStyles["*"]["*"];
  vs.background = [{ show: false }];
  vs.border = [{ show: false }];
  vs.dropShadow = [{ show: false }];
  vs.title = [{ show: !S.bake, fontColor: { solid: { color: p.ink } }, fontFamily: p.fh, alignment: "left" }];
  t.visualStyles.page = { "*": { background: [{ color: { solid: { color: p.bg } }, transparency: 0 }], outspace: [{ color: { solid: { color: p.bg } }, transparency: 0 }] } };
  t.visualStyles.actionButton = { "*": { fill: [{ show: false }], outline: [{ show: false }], icon: [{ show: false }], text: [{ show: false }] } };
  return t;
}

function positionsRows() {
  const rows = [["page", "zone", "visual", "x", "y", "width", "height"]];
  for (const pi of allPis()) for (const z of zones(pi)) rows.push([pi === -1 ? "Home" : S.pages[pi].name, z.name, z.what, z.x, z.y, z.w, z.h]);
  return rows;
}
const csv = (rows) => rows.map((r) => r.map((v) => /[",\n]/.test(String(v)) ? `"${String(v).replace(/"/g, '""')}"` : v).join(",")).join("\r\n");
