  for (const it of items) if (it.to !== pi) out.push(R0({ name: (pi === -1 ? "Tile: " : "Button: ") + it.name, what: "Page navigation to " + (it.to === -1 ? "Home" : S.pages[it.to].name), kind: "button", x: it.x, y: it.y, w: it.w, h: it.h, to: it.to }));
  if (pi !== -1) {
    for (const z of filterSlots(g)) out.push(R0({ name: "Filter: " + z.name, what: "Slicer (dropdown)", kind: "filter", slot: true, x: z.x, y: z.y, w: z.w, h: z.h }));
    for (const c of S.pages[pi].cards) {
      const r = rectOf(c, g), sl = slotOf(c, g);
      out.push(R0({ name: "Card: " + (c.title || TYPES[c.type].label), what: "Card frame in the background", kind: "card", id: c.id, x: r.x, y: r.y, w: r.w, h: r.h }));
