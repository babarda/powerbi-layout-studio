---
import Layout from "../../layouts/Layout.astro";
import presetData from "../../../public/tools/themekit/presets.json";
const presets = presetData.presets;
---
<Layout
  title="Power BI Layout Studio: page backgrounds, navigation and a ready .pbip · Badr Abardazzou"
  description="Free Power BI layout generator. Pick a navigation frame, a palette and a page layout, drag the cards on a live canvas, then download the page backgrounds (PNG or SVG), the matching theme .json, the exact X, Y, W, H of every visual, and a .pbip project with working page navigation. Runs in your browser, nothing uploaded."
  active="tools"
>
  <div class="pa tool lg">
    <script type="application/json" is:inline id="lg-presets" set:html={JSON.stringify(presets)}></script>

    <div class="head">
      <p class="eyebrow"><a href="/tools/">Tools</a></p>
      <h1>Power BI Layout Studio</h1>
      <p class="dek">Design the page before you build the report. Choose a navigation frame and a palette, drag the cards into place on a live canvas, and download the backgrounds, the theme, the exact position of every visual and a Power BI project with the page buttons already wired.</p>
    </div>

    <ol class="steps">
      <li><span class="two-n">1</span><div><b>Frame and colours</b><p>Seven navigation frames, 16 report palettes or your own brand colour, light or dark.</p></div></li>
      <li><span class="two-n">2</span><div><b>Arrange the cards</b><p>Start each page from a layout, then drag, resize or draw cards. Everything snaps to a 12 by 12 grid.</p></div></li>
      <li><span class="two-n">3</span><div><b>Take it to Power BI</b><p>PNG backgrounds, a theme .json, a positions table and a .pbip with navigation that works.</p></div></li>
    </ol>

    <div class="app" id="lg-app">
      <!-- ============================================================ RAIL -->
      <aside class="rail" aria-label="Layout settings">
        <section class="grp" data-open="1">
          <h2 class="gh"><button type="button" class="gt" aria-expanded="true"><span class="secn">1</span>Frame</button></h2>
          <div class="gb">
            <div class="frames" id="lg-frames"></div>
            <div class="lbl">Navigation colour</div>
            <div class="seg wide" id="lg-navtone"></div>
            <div class="lbl">Active page</div>
            <div class="seg wide" id="lg-active">
              <button type="button" data-v="fill">Filled</button>
              <button type="button" data-v="bar">Edge bar</button>
            </div>
            <div class="lbl">Canvas size</div>
            <div class="sizes" id="lg-sizes"></div>
          </div>
        </section>

        <section class="grp" data-open="1">
          <h2 class="gh"><button type="button" class="gt" aria-expanded="true"><span class="secn">2</span>Colours</button></h2>
          <div class="gb">
            <div class="seg wide" id="lg-mode">
              <button type="button" data-v="light">Light</button>
              <button type="button" data-v="dark">Dark</button>
            </div>
            <div class="pals" id="lg-pals">
              {presets.map((p) => (
                <button type="button" class="pal" data-id={p.id} aria-label={`Use the ${p.name} palette, made for ${p.madeFor}`} title={p.madeFor}>
                  <span class="pstrip">{p.brand.colors.slice(0, 5).map((c) => <i style={`background:${c}`}></i>)}</span>
                  <span class="pn">{p.name}</span>
                </button>
              ))}
            </div>
            <label class="acc">
              <input type="color" id="lg-accent" aria-label="Brand accent colour" />
              <span><b>Brand accent</b><small id="lg-accent-hex">from the palette</small></span>
              <button type="button" class="btn2 small quiet" id="lg-accent-reset">Palette colour</button>
            </label>
          </div>
        </section>

        <section class="grp" data-open="1">
          <h2 class="gh"><button type="button" class="gt" aria-expanded="true"><span class="secn">3</span>Pages and text</button></h2>
          <div class="gb">
            <label class="chk"><input type="checkbox" id="lg-menu" /> <span>Start with a home menu page</span></label>
            <ol class="plist" id="lg-pages"></ol>
            <button type="button" class="btn2 full" id="lg-addpage">Add a page</button>
            <div class="txt">
              <label>Report title <small>wrap a word in *stars* to colour it</small><input type="text" id="lg-title" maxlength="60" /></label>
              <label>Company<input type="text" id="lg-company" maxlength="40" /></label>
              <label>Subtitle<input type="text" id="lg-subtitle" maxlength="80" /></label>
              <label>Footer<input type="text" id="lg-footer" maxlength="90" /></label>
            </div>
            <div class="logo">
              <span class="lbl">Logo</span>
              <div class="logorow">
                <span class="logoprev" id="lg-logoprev"></span>
                <button type="button" class="btn2 small" id="lg-logo-btn">Upload logo</button>
                <button type="button" class="btn2 small quiet" id="lg-logo-del" hidden>Remove</button>
                <input type="file" id="lg-logo" accept="image/png,image/jpeg,image/svg+xml,image/webp" hidden />
              </div>
            </div>
          </div>
        </section>

        <section class="grp" data-open="1">
          <h2 class="gh"><button type="button" class="gt" aria-expanded="true"><span class="secn">4</span>Cards</button></h2>
          <div class="gb">
            <div class="cstyles" id="lg-cstyles"></div>
            <div class="lbl">Card colour</div>
            <div class="seg wide" id="lg-cfill">
              <button type="button" data-v="paper">Paper</button>
              <button type="button" data-v="tint">Tint</button>
            </div>
            <div class="lbl">Spacing</div>
            <div class="seg wide" id="lg-gap">
              <button type="button" data-v="8">Tight</button>
              <button type="button" data-v="14">Regular</button>
              <button type="button" data-v="22">Airy</button>
            </div>
            <label class="rng"><span>Corners <b id="lg-rad-v"></b></span><input type="range" id="lg-rad" min="0" max="20" step="2" /></label>
            <label class="chk"><input type="checkbox" id="lg-shadow" /> <span>Soft shadow</span></label>
            <label class="chk"><input type="checkbox" id="lg-phead" /> <span>Page title on every page</span></label>
            <label class="chk"><input type="checkbox" id="lg-bake" /> <span>Card titles drawn in the background</span></label>
          </div>
        </section>
      </aside>

      <!-- ============================================================ STAGE -->
      <div class="stage">
        <div class="tabsbar">
          <div class="ptabs" id="lg-ptabs" role="tablist" aria-label="Pages"></div>
          <div class="tools2">
            <button type="button" class="ib" id="lg-undo" aria-label="Undo" title="Undo (Ctrl+Z)"><svg viewBox="0 0 24 24"><path d="M9 7 4 12l5 5M4 12h11a5 5 0 0 1 0 10h-3"/></svg></button>
            <button type="button" class="ib" id="lg-redo" aria-label="Redo" title="Redo (Ctrl+Y)"><svg viewBox="0 0 24 24"><path d="m15 7 5 5-5 5M20 12H9a5 5 0 0 0 0 10h3"/></svg></button>
            <button type="button" class="ib tg" id="lg-grid" aria-pressed="true" title="Show the grid"><svg viewBox="0 0 24 24"><path d="M4 4h16v16H4zM9.3 4v16M14.7 4v16M4 9.3h16M4 14.7h16"/></svg></button>
            <button type="button" class="ib tg" id="lg-ghost" aria-pressed="true" title="Show sample visuals in the preview"><svg viewBox="0 0 24 24"><path d="M5 20V11M11 20V5M17 20v-6M3 20h18"/></svg></button>
          </div>
        </div>

        <div class="add" id="lg-add" aria-label="Add a card"></div>

        <div class="canvaswrap" id="lg-wrap" tabindex="0" aria-label="Page canvas. Click a card to select it, drag to move, drag the corner to resize, drag on empty space to draw a card. Arrow keys move, Shift and arrows resize, Delete removes.">
          <div class="canvas" id="lg-canvas"></div>
        </div>
        <p class="capt" id="lg-capt"></p>

        <div class="below">
          <div class="layouts">
            <div class="lbl">Start this page from a layout</div>
            <div class="lays" id="lg-lays"></div>
          </div>
          <div class="insp" id="lg-insp"></div>
        </div>
      </div>
    </div>

    <!-- ============================================================ EXPORT -->
    <h2 class="sec" id="download"><span class="secn">5</span>Take it to Power BI</h2>
    <div class="dlmain">
      <button type="button" class="dlbtn" id="lg-pbip">Download the Power BI project (.pbip)</button>
      <div class="dlmeta"><b id="lg-pbipname"></b><span>Every page with its background, page buttons that navigate, placeholder visuals in each card, and your theme.</span></div>
    </div>
    <div class="files">
      <div class="file"><b>This page as PNG</b><span class="fdesc">Twice the canvas size, sharp on any screen. Format page, Canvas background, Image, Fit.</span><div class="btnrow"><button type="button" class="btn2" id="lg-png">Download PNG</button><button type="button" class="btn2 quiet" id="lg-svg">SVG</button></div></div>
      <div class="file"><b>Every page (zip)</b><span class="fdesc">One PNG per page, the theme, the positions as CSV and a short read-me.</span><div class="btnrow"><button type="button" class="btn2" id="lg-zip">Download zip</button></div></div>
      <div class="file"><b>Theme (.json)</b><span class="fdesc">Data colours, fonts and transparent visuals so the background shows through. View, Themes, Browse for themes.</span><div class="btnrow"><button type="button" class="btn2" id="lg-theme">Download theme</button></div></div>
      <div class="file"><b>Positions</b><span class="fdesc">X, Y, width and height of every card and button, in Power BI pixels. Paste into Format, General, Properties.</span><div class="btnrow"><button type="button" class="btn2" id="lg-copy">Copy table</button><button type="button" class="btn2 quiet" id="lg-csv">CSV</button></div></div>
    </div>
    <p class="status" id="lg-status" role="status" aria-live="polite"></p>

    <div class="postab">
      <div class="phead"><h3 class="sub">Where each visual goes on <span id="lg-pos-page"></span></h3><span class="secnote">Power BI pixels at <span id="lg-pos-size"></span>. A visual placed on its slot lines up with the card in the background.</span></div>
      <div class="tscroll"><table id="lg-pos"></table></div>
    </div>

    <div class="notes">
      <div class="booknote">
        <b>How to use it in Power BI Desktop.</b> The fastest route is the .pbip: unzip it to a short path such as <code>C:\PBI\</code>, double-click the .pbip, and every page opens with its background, the theme and a placeholder visual on each card. Swap each placeholder for your own visual and keep its position. The page buttons already navigate. By hand: <span class="k">Format page</span>, <span class="k">Canvas background</span>, <span class="k">Browse</span>, pick the PNG, set <span class="k">Image fit</span> to <span class="k">Fit</span> and transparency to 0%. Then load the theme (<span class="k">View</span>, <span class="k">Themes</span>, <span class="k">Browse for themes</span>) so the visuals turn transparent, and type each visual's X, Y, width and height from the table above.
      </div>
      <div class="booknote">
        <b>Why the cards live in the background.</b> A shape drawn under every visual is the usual way to give a report a clean card look, and it costs a visual each time: more to load, more to align, more to restyle. A single background image carries every card, line and label at no cost to the report, and the theme switches the visual backgrounds off so the image shows through. When the layout changes, you export one new image instead of moving forty shapes.
      </div>
      <div class="booknote">
        <b>Why a 12 by 12 grid.</b> Cards that share column edges read as one system, so the eye can compare a KPI with the chart under it without hunting. Twelve columns divide into halves, thirds, quarters and sixths, which covers almost every report layout. Change the frame or the canvas size and the cards keep their place on the grid, so the layout follows.
      </div>
      <div class="booknote">
        <b>Privacy.</b> Everything runs in this page. Your logo is read by your browser and never uploaded, the images and the project are built on your machine, and your last layout is kept in this browser only. Related: <a href="/tools/theme-builder/">Theme Builder</a> for a full brand theme, <a href="/tools/theme-check/">Theme Check</a> to audit one, and the <a href="/tools/powerbi-templates/">Power BI project templates</a>.
      </div>
    </div>
  </div>
</Layout>

<style is:global>
  .shell:has(.lg){ max-width:1440px; }
  .lg{ --panel:#FBFCFB; --body:#293a35; --ink2:#101B18; --fail:#C0402E; color:var(--body); font-size:1.02rem; line-height:1.6; }
  .lg a{ color:var(--teal-ink); text-decoration:underline; text-underline-offset:3px; text-decoration-thickness:1.5px; text-decoration-color:rgba(14,157,138,.4); }
  .lg .head{ padding:clamp(30px,5vw,52px) 0 clamp(14px,2vw,22px); }
  .lg .eyebrow{ display:inline-flex; align-items:center; gap:10px; font-family:var(--mono); font-size:.7rem; letter-spacing:.2em; text-transform:uppercase; color:var(--teal-ink); margin:0 0 20px; }
  .lg .eyebrow::before{ content:""; width:26px; height:1px; background:var(--teal); }
  .lg .eyebrow a{ color:inherit; text-decoration:none; }
  .lg h1{ font-family:var(--serif); font-weight:600; font-size:clamp(2.1rem,5vw,3.1rem); line-height:1.08; letter-spacing:-.7px; margin:0; color:var(--ink2); }
  .lg .dek{ color:var(--mid); margin:18px 0 0; max-width:70ch; font-size:1.08rem; line-height:1.55; }
  .lg .steps{ list-style:none; padding:0; display:grid; grid-template-columns:repeat(3,1fr); gap:12px; margin:22px 0 0; }
  .lg .steps li{ display:flex; gap:14px; align-items:flex-start; padding:16px 18px; background:var(--panel); border:1px solid var(--hair-2); border-radius:14px; }
  .lg .two-n{ flex:none; width:30px; height:30px; border-radius:50%; background:var(--ink2); color:#fff; font-family:var(--serif); font-size:1rem; font-weight:600; display:flex; align-items:center; justify-content:center; }
  .lg .steps b{ display:block; font-family:var(--serif); font-size:1.14rem; color:var(--ink2); margin:2px 0 4px; }
  .lg .steps p{ margin:0; font-size:.88rem; color:var(--mid); line-height:1.5; }
  .lg .secn{ flex:none; width:24px; height:24px; border-radius:50%; background:var(--teal-ink); color:#fff; font-family:var(--sans, system-ui); font-size:.8rem; font-weight:600; display:inline-flex; align-items:center; justify-content:center; }
  .lg .sec{ font-family:var(--serif); font-weight:600; font-size:1.45rem; margin:44px 0 12px; color:var(--ink2); display:flex; align-items:center; gap:12px; }
  .lg .sec .secn{ width:28px; height:28px; font-size:.9rem; }
  .lg .lbl{ font-family:var(--mono); font-size:.62rem; letter-spacing:.14em; text-transform:uppercase; color:var(--teal-ink); font-weight:600; margin:14px 0 6px; display:block; }
  .lg code{ font-family:ui-monospace, Consolas, monospace; font-size:.84em; background:#EEF3F1; border-radius:4px; padding:1px 5px; color:var(--ink2); }
  .lg .k{ font-weight:600; color:var(--ink2); background:#fff; border:1px solid var(--hair-2); border-radius:5px; padding:0 5px; white-space:nowrap; font-size:.92em; }

  /* app shell */
  .lg .app{ display:grid; grid-template-columns:316px minmax(0,1fr); gap:22px; align-items:start; margin:28px 0 0; }
  .lg .rail{ position:sticky; top:12px; max-height:calc(100vh - 24px); overflow:auto; background:var(--panel); border:1px solid var(--hair-2); border-radius:16px; padding:6px 14px 14px; scrollbar-width:thin; }
  .lg .grp{ border-bottom:1px solid var(--hair); padding:4px 0 12px; }
  .lg .grp:last-child{ border-bottom:none; }
  .lg .gh{ margin:0; font-size:1rem; }
  .lg .gt{ all:unset; cursor:pointer; display:flex; align-items:center; gap:10px; width:100%; padding:10px 0 4px; font-family:var(--serif); font-weight:600; font-size:1.08rem; color:var(--ink2); }
  .lg .gt::after{ content:""; margin-left:auto; width:8px; height:8px; border-right:1.6px solid var(--faint); border-bottom:1.6px solid var(--faint); transform:rotate(45deg); transition:transform .15s; }
  .lg .grp[data-open="0"] .gt::after{ transform:rotate(-45deg); }
  .lg .grp[data-open="0"] .gb{ display:none; }
  .lg .gt:focus-visible{ outline:2px solid var(--teal-ink); outline-offset:3px; border-radius:6px; }

  .lg .frames{ display:grid; grid-template-columns:repeat(2,1fr); gap:8px; margin-top:8px; }
  .lg .fr{ font:inherit; cursor:pointer; background:#fff; border:1px solid var(--hair-2); border-radius:10px; padding:5px 5px 6px; display:flex; flex-direction:column; gap:4px; text-align:left; transition:border-color .12s, box-shadow .12s; }
  .lg .fr svg{ width:100%; height:auto; display:block; border-radius:6px; }
  .lg .fr span{ font-size:.74rem; font-weight:600; color:var(--ink2); padding:0 3px; }
  .lg .fr:hover{ border-color:var(--teal); }
  .lg .fr.on, .lg .cs.on, .lg .lay.on, .lg .sz.on{ border-color:var(--teal-ink); box-shadow:0 0 0 1.5px var(--teal-ink) inset; }

  .lg .seg{ display:inline-flex; border:1px solid var(--hair-2); border-radius:10px; overflow:hidden; background:#fff; }
  .lg .seg.wide{ display:flex; width:100%; }
  .lg .seg button{ font:inherit; flex:1; font-size:.8rem; font-weight:600; border:none; background:none; padding:7px 8px; color:var(--mid); cursor:pointer; display:inline-flex; align-items:center; justify-content:center; gap:6px; white-space:nowrap; }
  .lg .seg button + button{ border-left:1px solid var(--hair); }
  .lg .seg button.on{ background:var(--ink2); color:#fff; }
  .lg .seg button i{ width:12px; height:12px; border-radius:3px; border:1px solid rgba(0,0,0,.15); flex:none; }

  .lg .sizes{ display:grid; grid-template-columns:repeat(2,1fr); gap:6px; }
  .lg .sz{ flex-direction:row !important; justify-content:flex-start; gap:9px !important; padding:7px 9px !important; }
  .lg .sz span{ text-align:left !important; }
  .lg .sz{ font:inherit; cursor:pointer; background:#fff; border:1px solid var(--hair-2); border-radius:9px; padding:7px 4px 6px; display:flex; flex-direction:column; align-items:center; gap:5px; }
  .lg .sz i{ display:block; border:1.5px solid var(--ink2); border-radius:2px; }
  .lg .sz span{ font-size:.66rem; line-height:1.15; color:var(--mid); text-align:center; }
  .lg .sz span b{ display:block; color:var(--ink2); font-size:.7rem; }

  .lg .pals{ display:grid; grid-template-columns:repeat(2,1fr); gap:6px; margin-top:10px; }
  .lg .pal{ font:inherit; cursor:pointer; background:#fff; border:1px solid var(--hair-2); border-radius:9px; padding:6px 7px; display:flex; align-items:center; gap:7px; min-width:0; }
  .lg .pal:hover{ border-color:var(--teal); }
  .lg .pal.on{ border-color:var(--teal-ink); box-shadow:0 0 0 1.5px var(--teal-ink) inset; }
  .lg .pal .pstrip{ display:flex; width:46px; height:14px; border-radius:3px; overflow:hidden; flex:none; }
  .lg .pal .pstrip i{ flex:1; }
  .lg .pal .pn{ font-size:.72rem; font-weight:600; letter-spacing:.04em; color:var(--ink2); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .lg .acc{ display:flex; align-items:center; gap:10px; margin-top:10px; padding:8px 10px; background:#fff; border:1px solid var(--hair-2); border-radius:10px; }
  .lg .acc span{ flex:1; min-width:0; line-height:1.2; }
  .lg .acc b{ display:block; font-size:.8rem; color:var(--ink2); }
  .lg .acc small{ font-family:ui-monospace, Consolas, monospace; font-size:.72rem; color:var(--faint); }
  .lg input[type=color]{ width:34px; height:30px; padding:0; border:1px solid var(--hair-2); border-radius:7px; background:#fff; cursor:pointer; flex:none; }
  .lg input[type=color]::-webkit-color-swatch-wrapper{ padding:2px; }
  .lg input[type=color]::-webkit-color-swatch{ border:none; border-radius:5px; }

  .lg .chk{ display:flex; align-items:center; gap:8px; font-size:.84rem; color:var(--ink2); margin:10px 0 0; cursor:pointer; }
  .lg .chk input{ accent-color:var(--teal-ink); width:16px; height:16px; margin:0; }
  .lg .plist{ list-style:none; padding:0; margin:10px 0 8px; display:flex; flex-direction:column; gap:5px; }
  .lg .plist li{ display:flex; align-items:center; gap:5px; }
  .lg .plist li.cur input[type=text]{ border-color:var(--teal-ink); }
  .lg .pico{ flex:none; width:30px; height:30px; border:1px solid var(--hair-2); border-radius:8px; background:#fff; color:var(--ink2); cursor:pointer; padding:0; display:flex; align-items:center; justify-content:center; }
  .lg .pico svg, .lg .ib svg, .lg .addb svg{ width:16px; height:16px; fill:none; stroke:currentColor; stroke-width:1.8; stroke-linecap:round; stroke-linejoin:round; }
  .lg .pico:hover{ border-color:var(--teal-ink); color:var(--teal-ink); }
  .lg input[type=text]{ font:inherit; font-size:.86rem; border:1px solid var(--hair-2); border-radius:8px; padding:5px 8px; background:#fff; color:var(--ink2); min-width:0; box-sizing:border-box; }
  .lg .plist input[type=text]{ flex:1; }
  .lg .ib{ flex:none; width:28px; height:28px; border:1px solid var(--hair-2); border-radius:7px; background:#fff; color:var(--mid); cursor:pointer; font-size:.86rem; line-height:1; padding:0; display:inline-flex; align-items:center; justify-content:center; }
  .lg .ib:hover:not([disabled]){ border-color:var(--teal-ink); color:var(--teal-ink); }
  .lg .ib[disabled]{ opacity:.3; cursor:default; }
  .lg .ib.x:hover:not([disabled]){ border-color:var(--fail); color:var(--fail); }
  .lg .ib.tg[aria-pressed="true"]{ background:var(--ink2); color:#fff; border-color:var(--ink2); }
  .lg .txt{ display:flex; flex-direction:column; gap:8px; margin-top:14px; }
  .lg .txt label{ display:flex; flex-direction:column; gap:3px; font-size:.76rem; font-weight:600; color:var(--mid); }
  .lg .txt label small{ font-weight:400; color:var(--faint); }
  .lg .logorow{ display:flex; align-items:center; gap:8px; }
  .lg .logoprev{ width:40px; height:40px; border:1px dashed var(--hair-2); border-radius:8px; background:#fff center/contain no-repeat; flex:none; }
  .lg .cstyles{ display:grid; grid-template-columns:repeat(4,1fr); gap:6px; margin-top:8px; }
  .lg .cs{ font:inherit; cursor:pointer; background:#fff; border:1px solid var(--hair-2); border-radius:9px; padding:5px 4px 4px; display:flex; flex-direction:column; align-items:center; gap:3px; }
  .lg .cs svg{ width:100%; height:auto; display:block; }
  .lg .cs span{ font-size:.66rem; font-weight:600; color:var(--ink2); }
  .lg .rng{ display:flex; flex-direction:column; gap:2px; margin-top:12px; font-size:.8rem; color:var(--ink2); }
  .lg .rng b{ font-weight:600; color:var(--teal-ink); }
  .lg .rng input{ accent-color:var(--teal-ink); width:100%; }

  .lg .btn2{ font:inherit; font-size:.84rem; font-weight:600; background:#fff; color:var(--teal-ink); border:1px solid var(--teal-ink); border-radius:9px; padding:7px 12px; cursor:pointer; line-height:1.25; }
  .lg .btn2:hover:not([disabled]){ background:var(--teal-wash); }
  .lg .btn2[disabled]{ opacity:.45; cursor:default; }
