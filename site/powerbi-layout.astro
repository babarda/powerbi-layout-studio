/* ---------------------------------------------------------------- pbip */

const lit = (v) => ({ expr: { Literal: { Value: v } } });
const q = (s) => `'${String(s).replace(/'/g, "''")}'`;
const solid = (c) => ({ solid: { color: lit(q(c)) } });
const J = (o) => JSON.stringify(o, null, 2);
const SCH = "https://developer.microsoft.com/json-schemas/fabric/";
const uuid = () => (crypto.randomUUID ? crypto.randomUUID() : "10000000-1000-4000-8000-100000000000".replace(/[018]/g, (c) => (c ^ (crypto.getRandomValues(new Uint8Array(1))[0] & (15 >> (c / 4)))).toString(16)));
const pid = (pi) => (pi === -1 ? "home" : "p" + String(pi + 1).padStart(2, "0"));

function visualJson(name, pos, z, visual) {
  return J({ $schema: SCH + "item/report/definition/visualContainer/2.11.0/schema.json", name, position: { x: pos.x, y: pos.y, z, height: pos.h, width: pos.w, tabOrder: z }, visual });
}
const off = (k) => ({ [k]: [{ properties: { show: lit("false") } }] });
function buttonVisual(target, label) {
  const st = (id, props) => ({ properties: props, selector: { id } });
  return {
    visualType: "actionButton",
    objects: {
      fill: [st("default", { show: lit("false") }), st("hover", { show: lit("true"), fillColor: solid("#FFFFFF"), transparency: lit("85D") })],
      icon: [st("default", { show: lit("false") })], outline: [st("default", { show: lit("false") })], text: [st("default", { show: lit("false") })],
    },
    visualContainerObjects: {
      visualLink: [{ properties: { show: lit("true"), type: lit("'PageNavigation'"), navigationSection: lit(q(pid(target))), tooltip: lit(q("Open " + label)) } }],
      ...off("background"), ...off("border"), ...off("dropShadow"),
    },
    drillFilterOtherVisuals: true,
  };
}
function placeholderVisual(z) {
  const vco = { ...off("background"), ...off("border"), ...off("dropShadow") };
  if (!S.bake && z.title) vco.title = [{ properties: { show: lit("true"), text: lit(q(z.title)) } }];
  else vco.title = [{ properties: { show: lit("false") } }];
  if (z.type === "text") {
    return { visualType: "textbox", objects: { general: [{ properties: { paragraphs: [{ textRuns: [{ value: z.title || "Write the key message here", textStyle: { fontWeight: "bold", fontSize: "14pt", fontFamily: palette().fh } }] }, { textRuns: [{ value: "Replace this text with the two or three sentences the reader must take away.", textStyle: { fontSize: "10pt", fontFamily: palette().fb } }] }] } }] }, visualContainerObjects: vco, drillFilterOtherVisuals: true };
  }
